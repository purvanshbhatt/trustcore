{
  "name": "trustcore",
  "version": "1.0.0",
  "private": true,
  "description": "TrustCore — Shared AI Security & Readiness Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "start:web": "npm --prefix apps/web start",
    "dev:api": "cd services/api && python3 -m uvicorn app.main:app --reload --port 8000",
    "start:api": "cd services/api && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test:api": "cd services/api && python3 -m pytest tests/"
  },
  "keywords": [
    "ai-security",
    "readiness",
    "launchgate",
    "agentscope",
    "evidence-to-answer",
    "evalkit",
    "mcp-audit"
  ],
  "author": "TrustCore Team",
  "license": "Apache-2.0"
}
