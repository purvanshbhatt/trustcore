# TrustCore Monorepo Environment Configuration

# Backend API Service (services/api)
# Copy this file to .env for local development (`npm run dev:api` loads it).
# The API fails closed: if ENVIRONMENT is unset it runs as production and refuses to start
# without real auth, Stripe, CORS, and database settings. Only development / dev / local /
# test enable optional auth, mock billing, SQLite, and localhost CORS.
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# Exact web app origins allowed to call the API, comma separated. Required outside
# development; "*" is rejected, and http is accepted for localhost only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (per client IP) on /api/v1/run/* and /api/v1/ingest/*
RATE_LIMIT_SCAN=10/minute
RATE_LIMIT_INGEST=10/minute
# RATE_LIMIT_ENABLED=true
# Shared counter store when running more than one API instance, e.g. redis://host:6379
# RATE_LIMIT_STORAGE_URI=
# Reverse proxies in front of the API whose X-Forwarded-For entry is trusted
# (0 = use the TCP peer). Also keys the signed-out free preview. For a deployment, call
# GET /health from a normal client: forwarded_for_entries is the value to use here.
TRUSTED_PROXY_HOPS=0
# Salt for the hash that identifies signed-out visitors by IP (set a random value in production)
ANON_ID_SALT=

# Engine 2: LLM Explainer Layer (Dual-Engine Architecture)
# Deterministic engine executes first; LLM layer only formats explanations & remediation prompts
# Options: mock (deterministic) | gemini
LLM_EXPLAINER_PROVIDER=mock
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Hard deadline for the model call; on timeout the deterministic explanation is used.
# GEMINI_TIMEOUT_SECONDS=8
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payments & Billing
# MOCK_BILLING=true unlocks every scan and takes no payment. Local development only:
# the API refuses to start with it outside development, where it defaults to false.
MOCK_BILLING=true
# Scan credits granted per completed per-scan checkout
# STRIPE_PER_SCAN_CREDITS=1
# Outside development the two placeholder values below and Stripe test-mode keys stop
# startup. For a non-public staging environment that uses test keys:
# STRIPE_ALLOW_TEST_MODE=true
STRIPE_SECRET_KEY=sk_test_mock_secret_key_12345
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret_67890
STRIPE_PRICE_ID_PER_SCAN=price_per_scan_999
STRIPE_PRICE_ID_PRO=price_pro_monthly_4900
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_monthly_19900
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock_publishable_key_12345

# Authentication (Supabase Auth: email magic link + GitHub OAuth)
# AUTH_REQUIRED defaults to true unless ENVIRONMENT is development/dev/local/test.
# With auth off, unauthenticated requests run as the fixed user "local-dev-user".
# AUTH_REQUIRED=true
# Asymmetric signing keys (recommended): tokens are verified against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json and must carry the matching issuer.
SUPABASE_URL=
# Legacy HS256 projects only: Supabase Dashboard > Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Report Storage (per-user, Postgres / Supabase)
# Required outside development. Apply services/api/migrations/001_reports.sql first.
# Unset in development = local SQLite file at services/api/data/trustcore.db.
# Example (Supabase pooler): postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Create the reports table automatically on non-SQLite databases (skips RLS; not for Supabase).
# DB_AUTO_CREATE=false

# Frontend Web Application (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to false to call the API (required for real uploads, GitHub ingestion, and auth).
NEXT_PUBLIC_USE_MOCK=false
# Supabase browser client. Leave blank to run without sign-in (local development only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site details (legal pages, canonical URLs, sitemap, sprint contact CTA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_ENTITY=TrustCore
NEXT_PUBLIC_CONTACT_EMAIL=
# PostHog product analytics. Leave the key blank to disable analytics entirely
# (no network calls, no storage). EU projects: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
