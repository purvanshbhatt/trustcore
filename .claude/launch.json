{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "start"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "services/api/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "app.main:app", "--port", "8000",
        "--app-dir", "services/api", "--env-file", ".env.example"
      ],
      "port": 8000
    }
  ]
}
